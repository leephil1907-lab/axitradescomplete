# .env.production — Build-time environment variables for production builds
#
# This file IS committed to git and IS included in Docker builds (not in .gitignore or .dockerignore).
# Vite automatically loads this file during `vite build` (production mode).
#
# ONLY put PUBLIC, client-safe variables here (VITE_* prefix = exposed to frontend bundle).
# NEVER put server secrets (Stripe secret key, API tokens, passwords) here — those go in:
#   - Local .env (gitignored) for development
#   - Fly.io secrets (`fly secrets set ...`) for production runtime

# ── Stripe (publishable key is PUBLIC — safe to embed in frontend) ──
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TxYvXQ97HJg2P6QlqHhzADzPnvPuBrMW3OgWjbfVKm0QdeB2JIwmte00kn6gjsfGmPmAnvkjctqPP3aLZ5VoLrA008Oct4o52

# ── Tawk.to (already has hardcoded fallbacks in tawkto.ts, but set here for clarity) ──
VITE_TAWKTO_PROPERTY_ID=6a877895e687441d49b91140
VITE_TAWKTO_WIDGET_ID=default
VITE_TAWKTO_DIRECT_URL=https://tawk.to/chat/6a877895e687441d49b91140/default

# ── Firebase ──
# NOTE: Firebase config is also in firebase-applet-config.json (committed to repo)
# and src/firebase.ts falls back to it if these are not set.
# We set them here explicitly so the production build uses them directly.
VITE_FIREBASE_API_KEY=AIzaSyA8n0fjSb8as-l8IFDFjK-aqS2EEqYsIKY
VITE_FIREBASE_AUTH_DOMAIN=primordial-saga-447800-m3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=primordial-saga-447800-m3
VITE_FIREBASE_STORAGE_BUCKET=primordial-saga-447800-m3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=176432069025
VITE_FIREBASE_APP_ID=1:176432069025:web:45ccc70429e2f07733f3e0

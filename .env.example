# GEMINI_API_KEY: Required for Gemini AI API calls server-side (Keep secret!).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server Port
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server-side Firebase Admin credentials. NEVER expose these as VITE_* variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=
ADMIN_UIDS=

# Optional Client-side Firebase Configuration Overrides (public client configuration only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Stripe Live Credentials (server-side). Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Generic Trading Signal Webhook Secret
WEBHOOK_SECRET=

# Telegram Bot Notifications Integration (server-side)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Financial News APIs (server-side, optional)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Resend SMTP / email dispatch (server-side)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM_NAME="Axi Trades Official"
SMTP_FROM_EMAIL=

# Stripe publishable key is safe for the browser; keep secret keys server-side.
VITE_STRIPE_PUBLISHABLE_KEY=

# Tawk.to Live Support Chat Integration (public widget identifiers only)
VITE_TAWKTO_PROPERTY_ID=
VITE_TAWKTO_WIDGET_ID=
VITE_TAWKTO_DIRECT_URL=

# Telegram Alert Bot (server-side). Register a bot via @BotFather and send it a
# message first; TELEGRAM_CHAT_ID is that chat's numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp support (server-side). Number is used ONLY to build the wa.me deep
# link - it is never rendered as text on the site. Format: +18649358993
WHATSAPP_NUMBER=

# --- E2E test-run hints (never used by the app itself) ---
# Run the Stripe test-mode Funding Review E2E against a LOCAL dev server:
#   export API_BASE=http://localhost:3000
#   export STRIPE_SECRET_KEY=sk_test_...            # Stripe TEST key
#   export STRIPE_WEBHOOK_SECRET=whsec_...          # must match the server's
#   export ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=...
#   node scripts/e2e-stripe-funding.mjs             # or: npm run test:e2e:stripe
# For the DEPLOYED Railway app set API_BASE=https://<railway-app>.up.railway.app.
#
# Node: the project targets Node 22 (see .nvmrc / Dockerfile node:22-alpine).
# The Stripe card payment + Funding Review flow is test-mode only. Live keys are
# never to be used for these checks; Stripe must never auto-credit user balances.

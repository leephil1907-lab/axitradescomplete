# GEMINI_API_KEY: Required for Gemini AI API calls server-side (Keep secret!).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server Port
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional Client-side Firebase Configuration Overrides
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Stripe Live / Test Credentials (Server-side)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Generic Trading Signal Webhook Secret
WEBHOOK_SECRET=

# Telegram Bot Notifications Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_STRIPE_PUBLISHABLE_KEY=

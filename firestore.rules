rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'leephil1907@gmail.com',
          'admin@axi.com',
          'axicustomersupport@gmail.com'
        ] || request.auth.token.admin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'liveBalance'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 255
        && data.balance is number
        && data.liveBalance is number;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // A newly authenticated user may create only a zero-funded profile.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.balance == 0
        && request.resource.data.liveBalance == 0;

      // Users may maintain profile/KYC metadata, but financial ledgers and
      // authorization-sensitive fields are server/admin controlled.
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.liveBalance == resource.data.liveBalance
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'providerId', 'kycStatus', 'createdAt'
        ])
      );

      allow delete: if isAdmin();

      // Live positions are execution records. They must not be fabricated by
      // an untrusted browser; only the server/admin may write them.
      match /openPositions/{positionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      match /closedPositions/{positionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      match /transactions/{transactionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      match /priceAlerts/{alertId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /paymentMethods/{methodId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /watchlist/{symbolId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /kyc_submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(submissionId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Platform configuration is administrator-only. A normal trader must never
    // be able to change wallet addresses, payment methods or maintenance state.
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
